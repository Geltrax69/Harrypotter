# Living Page backend environment (placeholders only — never commit real values).
# Loaded via `node --env-file=.env`. Copy to `.env` and fill in.

NODE_ENV=development
PORT=8080
HOST=0.0.0.0

# Device bearer token the iPad app presents (min 16 chars). REQUIRED.
DEVICE_AUTH_TOKEN=replace-with-a-long-random-device-token

# Provider: "mock" (default) or "openrouter".
# Even if set to "openrouter", the service stays in mock mode until OPENROUTER_API_KEY is set.
PROVIDER=mock

# Server-only OpenRouter credential. Leave blank to force deterministic mock mode.
OPENROUTER_API_KEY=
# Comma-separated model list; later entries are fallbacks when earlier ones are rate-limited.
OPENROUTER_MODEL=inclusionai/ling-3.0-flash-sante:free,dots-studio/dots-3-note-preview:free,poolside/laguna-xs-2.1:free
OPENROUTER_TIMEOUT_MS=15000

# HTTP limits and rate limiting.
BODY_LIMIT_BYTES=16384
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000

# Idempotency store bounds.
IDEMPOTENCY_MAX_ENTRIES=10000
IDEMPOTENCY_TTL_MS=600000

# Logging.
LOG_LEVEL=info

# Set true only when running behind a trusted reverse proxy.
TRUST_PROXY=false
